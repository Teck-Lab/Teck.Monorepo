{
  "name": "teck-platform",
  "private": true,
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "format": "biome format --write src/apps src/packages",
    "typecheck": "nx run-many -t typecheck",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "affected:typecheck": "nx affected -t typecheck",
    "affected:all": "nx affected -t build test lint typecheck",
    "test:issue-relationships": "node --test .github/scripts/issue-relationships.test.mjs",
    "graph": "nx graph",
    "release:prepare": "node .github/scripts/prepare-release.mjs",
    "release:prepare:dry": "node .github/scripts/prepare-release.mjs --dry-run",
    "clean": "nx reset",
    "prepare": "husky",
    "test:release": "node --test commitlint.config.test.mjs .github/scripts/release-scopes.test.mjs .github/scripts/platform-release.test.mjs",
    "release:publish": "node .github/scripts/publish-release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/ensure": "21.2.4",
    "@commitlint/lint": "21.2.4",
    "@expo/cli": "~58.1.19",
    "@nx/devkit": "23.3.0",
    "@nx/docker": "23.3.0",
    "@nx/dotnet": "23.3.0",
    "@nx/expo": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/next": "23.3.0",
    "@nx/react": "23.3.0",
    "@nx/storybook": "23.3.0",
    "@swc-node/register": "~1.12.1",
    "@swc/cli": "~0.8.2",
    "@swc/core": "~1.16.22",
    "@swc/helpers": "~0.5.24",
    "@tailwindcss/postcss": "^4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-preset-expo": "~58.0.24",
    "husky": "^9.1.7",
    "metro-config": "~0.88.0",
    "metro-resolver": "~0.88.0",
    "nativewind": "5.0.0-rc.0",
    "nx": "23.3.0",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@auto-it/conventional-commits": "11.3.6",
    "@auto-it/core": "11.3.6",
    "@auto-it/git-tag": "11.3.6",
    "@auto-it/released": "11.3.6",
    "semver": "7.8.6",
    "tapable": "2.3.3"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "packageManager": "bun@1.2.5",
  "workspaces": [
    "src/apps/*",
    "src/packages/*"
  ],
  "dependencies": {
    "@expo/metro-config": "~58.0.21",
    "@expo/metro-runtime": "~58.0.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@rn-primitives/slot": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~58.0.23",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react": "^1.70.0",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.1",
    "react-native-svg-transformer": "~1.5.1",
    "react-native-web": "~0.21.4",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.9.1"
  }
}
