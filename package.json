{
  "name": "teck-platform",
  "private": true,
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "format": "biome format --write src/apps src/packages",
    "typecheck": "nx run-many -t typecheck",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "affected:typecheck": "nx affected -t typecheck",
    "affected:all": "nx affected -t build test lint typecheck",
    "test:issue-relationships": "node --test .github/scripts/issue-relationships.test.mjs",
    "graph": "nx graph",
    "release:plan": "nx release plan",
    "release:plan:check": "nx release plan:check",
    "release:prepare": "node .github/scripts/prepare-release.mjs",
    "release:prepare:dry": "node .github/scripts/prepare-release.mjs --dry-run",
    "clean": "nx reset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/ensure": "21.2.3",
    "@commitlint/lint": "21.2.3",
    "@expo/cli": "~57.0.28",
    "@nx/devkit": "latest",
    "@nx/docker": "23.1.1",
    "@nx/dotnet": "latest",
    "@nx/expo": "23.1.1",
    "@nx/js": "latest",
    "@nx/next": "latest",
    "@nx/react": "23.1.1",
    "@nx/storybook": "latest",
    "@swc-node/register": "~1.12.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.16.13",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-preset-expo": "~57.0.14",
    "husky": "^9.1.7",
    "metro-config": "~0.87.1",
    "metro-resolver": "~0.87.1",
    "nativewind": "^5.0.0-preview.4",
    "nx": "latest",
    "tailwindcss": "^4",
    "typescript": "^5.7.0"
  },
  "packageManager": "bun@1.2.5",
  "workspaces": [
    "src/apps/*",
    "src/packages/*"
  ],
  "dependencies": {
    "@expo/metro-config": "~57.0.13",
    "@expo/metro-runtime": "~55.0.11",
    "@radix-ui/react-slot": "^1.4.0",
    "@rn-primitives/slot": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.27",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react": "^1.52.0",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "react-native": "0.87.1",
    "react-native-svg": "15.15.5",
    "react-native-svg-transformer": "~1.5.1",
    "react-native-web": "~0.21.3",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.3.0"
  }
}
