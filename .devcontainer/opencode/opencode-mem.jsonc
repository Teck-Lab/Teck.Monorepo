{
  // opencode-mem config, seeded to ~/.config/opencode/opencode-mem.jsonc by
  // postCreate.sh. The plugin auto-installs via opencode.json's `plugin` array.

  // Storage lives UNDER the persisted opencode data volume (~/.local/share/opencode
  // is a named volume, see devcontainer.json mounts), so captured memories survive
  // container rebuilds. (Default would be ~/.opencode-mem/data — ephemeral.)
  "storagePath": "~/.local/share/opencode/opencode-mem/data",

  // On-device embedding model, downloaded from HuggingFace on first use (needs
  // network once; no API key). No external DB — SQLite + local vector index.
  "embeddingModel": "Xenova/nomic-embed-text-v1",

  // Memory web UI at http://127.0.0.1:4747 (port forwarded in devcontainer.json).
  "webServerEnabled": true,
  "webServerPort": 4747,

  // Auto-capture summarizes technical work into memory via a background AI request.
  "autoCaptureEnabled": true,
  "autoCaptureLanguage": "auto",
  "showAutoCaptureToasts": true,

  // Route capture through the local LiteLLM gateway (opencode owns auth/routing).
  // Provider name must match an entry in `opencode providers list` (ours: `litellm`).
  //
  // Pinned to deepseek-v4-flash because auto-capture fires on EVERY prompt, so it
  // needs a high-capacity route. Its pool has five routes (OpenCode Go sub A + sub
  // B, OpenCode Zen free, NVIDIA NIM free, DeepSeek API), so a cooled route just
  // shifts traffic instead of failing.
  //
  // Do NOT point this at gemini-2.5-flash: the Gemini free tier is 20 requests per
  // DAY (GenerateRequestsPerDayPerProjectPerModel-FreeTier), that pool is
  // single-route, and LiteLLM has no cross-model fallback — so once the daily quota
  // is gone every capture hard-fails with a 429. Reserve Gemini for the vision work
  // that actually needs it (multimodal-looker, visual-engineering).
  //
  // Alternative: "opencodeModel": "inherit" captures with whatever model answered
  // each prompt (only works if that model supports structured output).
  "opencodeProvider": "litellm",
  "opencodeModel": "deepseek-v4-flash"
}
