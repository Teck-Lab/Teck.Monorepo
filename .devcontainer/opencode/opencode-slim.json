{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/deepseek-v4-pro",
  "plugin": [
    "oh-my-opencode-slim@2.2.10",
    "cc-safety-net",
    "opencode-mem",
    "opencode-snip@1.6.1",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "agent": {
    "explore": { "disable": true },
    "general": { "disable": true }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng@1.11.1"],
      "environment": { "SEARXNG_URL": "http://localhost:8888" },
      "enabled": true
    },
    "crawl4ai": {
      "type": "remote",
      "url": "http://localhost:11235/mcp/sse",
      "headers": { "Authorization": "Bearer {env:CRAWL4AI_API_TOKEN}" },
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["/usr/local/bin/teck-github-mcp"],
      "enabled": true
    }
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM local gateway",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro (pool)" },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash (pool)" },
        "glm-5.2": { "name": "GLM 5.2 (pool)" },
        "minimax-m3": { "name": "MiniMax M3 (pool)" },
        "mimo-v2.5": { "name": "MiMo v2.5 (pool)" },
        "kimi-k3": { "name": "Kimi K3" },
        "kimi-k2.7-code": { "name": "Kimi K2.7 Code" },
        "kimi-k2.6": { "name": "Kimi K2.6" },
        "qwen3.7-max": { "name": "Qwen 3.7 Max" },
        "qwen3.7-plus": { "name": "Qwen 3.7 Plus" },
        "qwen3.6-plus": { "name": "Qwen 3.6 Plus" },
        "qwen3.5-plus": { "name": "Qwen 3.5 Plus" },
        "hy3": { "name": "Hy3 (pool)" },
        "nemotron-3-ultra": { "name": "Nemotron 3 Ultra (free)" },
        "north-mini-code": { "name": "North Mini Code (free)" },
        "gemini-2.5-flash": { "name": "Gemini 2.5 Flash" },
        "llama-3.3-70b": { "name": "Llama 3.3 70B (pool)" },
        "deepseek-v3.2": { "name": "DeepSeek V3.2" },
        "deepseek-r1-distill-qwen-32b": { "name": "DeepSeek R1 Distill Qwen 32B" },
        "qwen2.5-coder-32b": { "name": "Qwen 2.5 Coder 32B" }
      }
    }
  }
}
