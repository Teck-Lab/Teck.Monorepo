{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "plugin": ["oh-my-openagent@4.19.4", "cc-safety-net", "opencode-mem", "opencode-snip@1.6.1"],
  "agent": {
    "explore": { "disable": true },
    "general": { "disable": true }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng@1.11.1"],
      "environment": { "SEARXNG_URL": "{env:SEARXNG_URL}" },
      "enabled": true
    },
    "crawl4ai": {
      "type": "remote",
      "url": "{env:CRAWL4AI_URL}",
      "headers": { "Authorization": "Bearer {env:CRAWL4AI_API_TOKEN}" },
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["/usr/local/bin/teck-github-mcp"],
      "enabled": true
    }
  },
  "provider": {
    "opencode-go-a": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go A",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "apiKey": "{env:OPENCODE_GO_KEY}"
      },
      "models": {
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro" },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash" },
        "glm-5.2": { "name": "GLM 5.2" },
        "mimo-v2.5": { "name": "MiMo v2.5" },
        "kimi-k3": { "name": "Kimi K3" },
        "kimi-k2.7-code": { "name": "Kimi K2.7 Code" },
        "qwen3.7-plus": { "name": "Qwen 3.7 Plus" }
      }
    },
    "opencode-go-b": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go B",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "apiKey": "{env:OPENCODE_GO_KEY_2}"
      },
      "models": {
        "deepseek-v4-pro": {},
        "deepseek-v4-flash": {},
        "glm-5.2": {},
        "mimo-v2.5": {},
        "kimi-k3": {},
        "kimi-k2.7-code": {},
        "qwen3.7-plus": {}
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": { "baseURL": "https://api.deepseek.com/v1", "apiKey": "{env:DEEPSEEK_API_KEY}" },
      "models": { "deepseek-v4-pro": {}, "deepseek-v4-flash": {} }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "deepseek/deepseek-v4-flash-0731": { "name": "DeepSeek V4 Flash 0731" },
        "z-ai/glm-5.2": {},
        "xiaomi/mimo-v2.5": {}
      }
    }
  }
}
