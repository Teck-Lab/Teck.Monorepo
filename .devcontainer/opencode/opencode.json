{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-terra",
  "plugin": [
    "oh-my-openagent@4.19.4",
    "cc-safety-net",
    "opencode-mem",
    "opencode-snip@1.6.1"
  ],
  "agent": {
    "explore": { "disable": true },
    "general": { "disable": true }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng@1.11.1"],
      "environment": { "SEARXNG_URL": "http://localhost:8888" },
      "enabled": true
    },
    "crawl4ai": {
      "type": "remote",
      "url": "http://localhost:11235/mcp/sse",
      "headers": { "Authorization": "Bearer {env:CRAWL4AI_API_TOKEN}" },
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["/usr/local/bin/teck-github-mcp"],
      "enabled": true
    }
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM local gateway",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro (pool)" },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash (pool)" },
        "glm-5.2": { "name": "GLM 5.2 (pool)" },
        "mimo-v2.5": { "name": "MiMo v2.5 (pool)" },
        "kimi-k3": { "name": "Kimi K3" },
        "kimi-k2.7-code": { "name": "Kimi K2.7 Code" },
        "qwen3.7-plus": { "name": "Qwen 3.7 Plus" }
      }
    }
  }
}
