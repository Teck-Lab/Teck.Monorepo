{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "agents": {
      "sisyphus": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "medium",
        "prompt_append": "When this is an ordinary manually opened Orca worktree without an injected orchestration Dispatch, you own implementation, validation, meaningful conventional local commits, and publication. Read and follow .agents/skills/teck-direct-worktree-flow/SKILL.md. Treat explicit requests to fix this branch or fix/update this PR as authorization to commit and publish the completed fix. Local commit signing is intentionally disabled: create unsigned checkpoint commits and never treat that as a blocker. Never use ordinary git push; publish with tools/github-app-publish so GitHub receives equivalent App-authored verified commits. Do not send worker_done or invoke the orchestrated feature flow unless an Orca Dispatch explicitly requires it. Preserve unrelated existing changes and never merge a PR or create tags.",
        "permission": {
          "bash": {
            "*": "allow",
            "git push*": "deny",
            "git merge*": "deny",
            "git rebase*": "deny",
            "git worktree*": "deny",
            "teck-git-with-github-app*": "deny"
          }
        }
      },
      "prometheus": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      },
      "atlas": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high"
      },
      "hephaestus": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "medium"
      },
      "momus": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high"
      },
      "metis": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high"
      },
      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "xhigh"
      },
      "multimodal-looker": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "medium"
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna",
        "reasoning": "medium"
      },
      "explore": {
        "model": "openai/gpt-5.6-luna",
        "reasoning": "medium"
      },
      "sisyphus-junior": {
        "model": "openai/gpt-5.6-luna",
        "reasoning": "low"
      }
    },
    "categories": {
      "quick": {
        "model": "openai/gpt-5.6-luna",
        "reasoning": "low"
      },
      "deep": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "medium"
      },
      "ultrabrain": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "max"
      },
      "unspecified-low": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high"
      },
      "unspecified-high": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      },
      "writing": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "medium"
      },
      "visual-engineering": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      }
    },
    "background_task": {
      "defaultConcurrency": 8,
      "providerConcurrency": {
        "openai": 5
      }
    },
    "hashline_edit": true,
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [400, 401, 403, 404, 429, 500, 502, 503, 504],
      "max_fallback_attempts": 4,
      "cooldown_seconds": 15,
      "timeout_seconds": 15,
      "notify_on_fallback": true
    },
    "sisyphus_agent": {
      "disabled": false,
      "default_builder_enabled": false,
      "planner_enabled": true,
      "replace_plan": true
    },
    "tmux": {
      "enabled": true,
      "layout": "main-horizontal",
      "main_pane_size": 60,
      "main_pane_min_width": 90,
      "agent_pane_min_width": 36
    },
    "git_master": {
      "commit_footer": false,
      "include_co_authored_by": false
    },
    "disabled_hooks": ["auto-update-checker", "startup-toast"],
    "experimental": {
      "aggressive_truncation": true,
      "task_system": true
    }
  }
}
