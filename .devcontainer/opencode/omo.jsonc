{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "agents": {
      "sisyphus": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "medium",
        "prompt_append": "When this is an ordinary manually opened Orca worktree without an injected orchestration Dispatch, you own implementation, validation, meaningful conventional local commits, and publication. Read and follow .agents/skills/teck-direct-worktree-flow/SKILL.md. Treat explicit requests to fix this branch or fix/update this PR as authorization to commit and publish the completed fix. Local commit signing is intentionally disabled: create unsigned checkpoint commits and never treat that as a blocker. Use the authenticated GitHub CLI for publication; never force-push. Do not send worker_done or invoke the orchestrated feature flow unless an Orca Dispatch explicitly requires it. Preserve unrelated existing changes and never merge a PR or create tags.",
        "permission": {
          "bash": {
            "*": "allow",
            "git push*": "deny",
            "git merge*": "deny",
            "git rebase*": "deny",
            "git worktree*": "deny",
            "git push --force*": "deny"
          }
        }
      },
      "prometheus": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high",
        "prompt_append": "You plan either one parent feature decomposition or one Orca-dispatched GitHub sub-issue in an existing brownfield monorepo. Treat the injected Task and assigned worktree as hard scope boundaries. Produce the smallest correct plan that preserves existing architecture and behavior. Do not edit code or create worktrees, branches, commits, pushes, pull requests, GitHub mutations, or Orca Tasks. When the Task says plan-only, do not invoke /start-work; return the proposed executable leaves, dependencies, acceptance criteria, validation, overlap risks, and plan defects through worker_done so the coordinator can reconcile durable state."
      },
      "atlas": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high",
        "prompt_append": "You are the primary executor for one Orca Dispatch. Work only in the assigned child worktree and branch. You may delegate bounded work through OMO, but nested agents never own Git, GitHub, Orca worktrees, or lifecycle state. Review delegated output, validate, create unsigned conventional local checkpoint commits yourself, and send worker_done exactly once using the injected preamble. Never push, merge, create worktrees, mutate GitHub, or infer completion from terminal or tmux state."
      },
      "hephaestus": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "medium",
        "prompt_append": "You are the primary deep or spike executor for one Orca Dispatch. Stay inside the assigned child worktree and branch. Do not create worktrees, push, merge, mutate GitHub, or delegate Orca lifecycle authority. Validate implementation outcomes, create unsigned conventional local checkpoint commits when requested, and send worker_done exactly once; use ask or escalation when the bounded goal cannot be completed safely."
      },
      "momus": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high"
      },
      "metis": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high"
      },
      "oracle": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "xhigh"
      },
      "multimodal-looker": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "medium"
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna",
        "reasoning": "medium"
      },
      "explore": {
        "model": "openai/gpt-5.6-luna",
        "reasoning": "medium"
      },
      "sisyphus-junior": {
        "model": "openai/gpt-5.6-luna",
        "reasoning": "low"
      }
    },
    "categories": {
      "quick": {
        "model": "openai/gpt-5.6-luna",
        "reasoning": "low"
      },
      "deep": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "medium"
      },
      "ultrabrain": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "max"
      },
      "unspecified-low": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "high"
      },
      "unspecified-high": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      },
      "writing": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "medium"
      },
      "visual-engineering": {
        "model": "openai/gpt-5.6-sol",
        "reasoning": "high"
      }
    },
    "background_task": {
      "defaultConcurrency": 8,
      "providerConcurrency": {
        "openai": 5
      }
    },
    "hashline_edit": true,
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [400, 401, 403, 404, 429, 500, 502, 503, 504],
      "max_fallback_attempts": 4,
      "cooldown_seconds": 15,
      "timeout_seconds": 15,
      "notify_on_fallback": true
    },
    "sisyphus_agent": {
      "disabled": false,
      "default_builder_enabled": false,
      "planner_enabled": true,
      "replace_plan": true
    },
    "tmux": {
      "enabled": true,
      "layout": "main-horizontal",
      "main_pane_size": 60,
      "main_pane_min_width": 90,
      "agent_pane_min_width": 36
    },
    "git_master": {
      "commit_footer": false,
      "include_co_authored_by": false
    },
    "disabled_hooks": ["auto-update-checker", "startup-toast"],
    "experimental": {
      "aggressive_truncation": true,
      "task_system": true
    }
  }
}
