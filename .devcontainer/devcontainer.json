{
  "name": "Teck Platform",
  "dockerComposeFile": ["compose.yaml", "mcp/compose.yaml"],
  "service": "workspace",
  "workspaceFolder": "/workspaces/Teck.Monorepo",
  "initializeCommand": "bash .devcontainer/prepare-compose.sh",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0.300"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers-extra/features/bun:1": {
      "version": "1.2.5"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "./features/oh-my-codex": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/dirien/devcontainer-feature-codex/codex:0": {}
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "NUGET_XMLDOC_MODE": "skip",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "OMX_AUTO_UPDATE": "0",
    "OMX_LAUNCH_POLICY": "direct"
  },
  "mounts": [
    "source=codex-config-${devcontainerId},target=/home/vscode/.codex,type=volume",
    "source=${localEnv:HOME}/.codex/auth.json,target=/home/vscode/.codex/auth.json,type=bind",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind"
  ],
  "forwardPorts": [18888, 3000, 8080, 8081, 19000, 19006],
  "portsAttributes": {
    "18888": { "label": "Aspire dashboard" },
    "3000": { "label": "Next.js dev" },
    "8080": { "label": "Service host" },
    "8081": { "label": "Metro / Expo web" },
    "19000": { "label": "Expo Go (LAN)" },
    "19006": { "label": "Expo web (legacy)" }
  },
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "biomejs.biome",
        "nrwl.angular-console",
        "editorconfig.editorconfig",
        "expo.vscode-expo-tools"
      ]
    }
  }
}
