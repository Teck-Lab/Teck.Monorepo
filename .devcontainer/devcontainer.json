{
  "name": "Teck Platform",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0.300"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers-extra/features/bun:1": {
      "version": "1.2.0"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/opencode:1": {},
    "ghcr.io/dirien/devcontainer-feature-codex/codex:0": {}
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "NUGET_XMLDOC_MODE": "skip",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude-config"
  },
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude-config,type=volume",
    "source=opencode-data-${devcontainerId},target=/home/vscode/.local/share/opencode,type=volume",
    "source=codex-config-${devcontainerId},target=/home/vscode/.codex,type=volume",
    "source=${localEnv:HOME}/.gnupg,target=/home/vscode/.gnupg-host,type=bind,readonly"
  ],
  "forwardPorts": [18888, 4000, 4747, 3000, 8080, 8081, 19000, 19006],
  "portsAttributes": {
    "18888": { "label": "Aspire dashboard" },
    "4000": { "label": "LiteLLM gateway" },
    "4747": { "label": "opencode-mem UI" },
    "3000": { "label": "Next.js dev" },
    "8080": { "label": "Service host" },
    "8081": { "label": "Metro / Expo web" },
    "19000": { "label": "Expo Go (LAN)" },
    "19006": { "label": "Expo web (legacy)" }
  },
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "postStartCommand": "bash .devcontainer/start-litellm.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "biomejs.biome",
        "nrwl.angular-console",
        "editorconfig.editorconfig",
        "expo.vscode-expo-tools"
      ]
    }
  }
}
