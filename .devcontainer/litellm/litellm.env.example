# Copy this file to .devcontainer/litellm.env (which is gitignored) and fill in
# real values. The launcher (.devcontainer/start-litellm.sh) passes it to the
# LiteLLM container via --env-file. Real provider keys never leave the container.
#
# A pool member whose key is missing/blank will simply 429/error and be cooled
# down — the gateway still boots. Comment out its line in config.yaml if you don't
# have a provider's key and want to silence its errors.

# --- Gateway auth: the key CLIENTS (e.g. OpenCode) present to the proxy ---
# Not a provider key; choose any value. It only guards the local proxy.
LITELLM_MASTER_KEY=sk-local-dev-changeme

# --- OpenCode Go (Zen) flat-rate subs — verified primary of every pool ---
OPENCODE_GO_KEY=
OPENCODE_GO_KEY_2=

# --- DeepSeek official API (paid per-token; the *-net fallbacks + co-primary) ---
DEEPSEEK_API_KEY=

# --- NVIDIA NIM (free 40 RPM DeepSeek v4 routes) ---
NVIDIA_API_KEY=

# --- Free-tier providers ---
GEMINI_API_KEY=
SAMBANOVA_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=      # required by the cloudflare/@cf/... entries
OPENROUTER_API_KEY=
