# Copy to proton-pass.env. Prefer stable vault/item IDs over names.
# Grant the Proton PAT viewer access only to the referenced items.
TECK_GITHUB_APP_ID=pass://Agentic/Teck GitHub App/app-id
TECK_GITHUB_APP_INSTALLATION_ID=pass://Agentic/Teck GitHub App/installation-id
TECK_GITHUB_APP_PRIVATE_KEY=pass://Agentic/Teck GitHub App/private-key-pem
TECK_GIT_AUTOMATION_NAME=pass://Agentic/Teck Agent Signing/git-name
TECK_GIT_AUTOMATION_EMAIL=pass://Agentic/Teck Agent Signing/git-email
TECK_GIT_SIGNING_PRIVATE_KEY=pass://Agentic/Teck Agent Signing/private-key-armored
