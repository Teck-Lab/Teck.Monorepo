#!/usr/bin/env sh
# Pre-push gate: full local mirror of the CI security gate on changed files
# (Gitleaks history + Semgrep SAST + Trivy SCA). First run pulls scanner images.
# Bypass in an emergency: git push --no-verify (CI still gates everything).

./tools/security-scan.sh || {
  echo "pre-push: security scan failed — see .security/ for reports" >&2
  exit 1
}
