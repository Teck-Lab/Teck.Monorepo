#!/usr/bin/env sh
# Pre-push gate: Gitleaks scans only the refs this push introduces; Semgrep
# and Trivy retain the changed-files local security scan. CI remains the
# authoritative full-history Gitleaks gate.

./tools/security-scan.sh --pre-push || {
  echo "pre-push: security scan failed — see .security/ for reports" >&2
  exit 1
}
