{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "gateway-public-stable",
    "annotations": {
      "argocd.argoproj.io/sync-wave": "2"
    }
  },
  "spec": {
    "selector": {
      "app": "gateway-public"
    },
    "ports": [
      {
        "name": "http",
        "port": 80,
        "targetPort": "http"
      }
    ]
  }
}
