{
  "apiVersion": "gateway.networking.k8s.io/v1",
  "kind": "HTTPRoute",
  "metadata": {
    "name": "gateway-public",
    "annotations": {
      "argocd.argoproj.io/sync-wave": "2"
    }
  },
  "spec": {
    "parentRefs": [
      {
        "name": "application-gateway"
      }
    ],
    "hostnames": [
      "application.invalid"
    ],
    "rules": [
      {
        "matches": [
          {
            "path": {
              "type": "PathPrefix",
              "value": "/"
            }
          }
        ],
        "backendRefs": [
          {
            "name": "gateway-public-stable",
            "port": 80,
            "weight": 100
          },
          {
            "name": "gateway-public-canary",
            "port": 80,
            "weight": 0
          }
        ]
      }
    ]
  }
}
