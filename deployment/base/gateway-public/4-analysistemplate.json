{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "AnalysisTemplate",
  "metadata": {
    "name": "gateway-public-health",
    "annotations": {
      "argocd.argoproj.io/sync-wave": "2"
    }
  },
  "spec": {
    "metrics": [
      {
        "name": "dependency-health",
        "count": 1,
        "failureLimit": 0,
        "provider": {
          "job": {
            "spec": {
              "backoffLimit": 0,
              "activeDeadlineSeconds": 60,
              "template": {
                "spec": {
                  "restartPolicy": "Never",
                  "containers": [
                    {
                      "name": "check",
                      "image": "docker.io/library/busybox:1.37.0@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e",
                      "command": [
                        "sh",
                        "-c",
                        "wget -qO- http://gateway-public-canary.{{args.namespace}}.svc.cluster.local/alive | grep -qx Healthy"
                      ],
                      "resources": {
                        "requests": {
                          "cpu": "10m",
                          "memory": "16Mi"
                        },
                        "limits": {
                          "memory": "64Mi"
                        }
                      }
                    }
                  ]
                }
              },
              "ttlSecondsAfterFinished": 300
            }
          }
        }
      }
    ],
    "args": [
      {
        "name": "namespace"
      }
    ]
  }
}
