{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "Rollout",
  "metadata": {
    "name": "gateway-web-customer",
    "annotations": {
      "argocd.argoproj.io/sync-wave": "2"
    }
  },
  "spec": {
    "replicas": 2,
    "revisionHistoryLimit": 2,
    "selector": {
      "matchLabels": {
        "app": "gateway-web-customer"
      }
    },
    "strategy": {
      "canary": {
        "stableService": "gateway-web-customer-stable",
        "canaryService": "gateway-web-customer-canary",
        "trafficRouting": {
          "plugins": {
            "argoproj-labs/gatewayAPI": {
              "httpRoute": "gateway-web-customer"
            }
          }
        },
        "steps": [
          {
            "setWeight": 50
          },
          {
            "pause": {
              "duration": "10s"
            }
          },
          {
            "analysis": {
              "templates": [
                {
                  "templateName": "gateway-web-customer-health"
                }
              ],
              "args": [
                {
                  "name": "namespace",
                  "valueFrom": {
                    "fieldRef": {
                      "fieldPath": "metadata.namespace"
                    }
                  }
                }
              ]
            }
          },
          {
            "setWeight": 100
          }
        ]
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "gateway-web-customer",
          "teck.orca.io/role": "application"
        }
      },
      "spec": {
        "serviceAccountName": "gateway-web-customer",
        "containers": [
          {
            "name": "app",
            "image": "ghcr.io/teck-lab/gateway-web-customer",
            "ports": [
              {
                "name": "http",
                "containerPort": 8080
              }
            ],
            "env": [
              {
                "name": "ASPNETCORE_HTTP_PORTS",
                "value": "8080"
              },
              {
                "name": "Keycloak__credentials__secret",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "gateway-web-customer-auth",
                    "key": "client-secret"
                  }
                }
              },
              {
                "name": "Keycloak__resource",
                "value": "web-customer-gateway"
              }
            ],
            "startupProbe": {
              "httpGet": {
                "path": "/alive",
                "port": "http"
              },
              "failureThreshold": 60,
              "periodSeconds": 2
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/alive",
                "port": "http"
              },
              "periodSeconds": 3
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/alive",
                "port": "http"
              },
              "periodSeconds": 10
            },
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "128Mi"
              },
              "limits": {
                "cpu": "1",
                "memory": "512Mi"
              }
            }
          }
        ]
      }
    }
  }
}
