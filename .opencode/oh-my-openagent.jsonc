{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "prompt_append": "When this is an ordinary manually opened Orca worktree without an injected orchestration Dispatch, you own implementation, validation, meaningful conventional local commits, and publication. Read and follow .agents/skills/teck-direct-worktree-flow/SKILL.md. Treat explicit requests to fix this branch or fix/update this PR as authorization to commit and publish the completed fix. Local commit signing is intentionally disabled: create unsigned checkpoint commits and never treat that as a blocker. Use the authenticated GitHub CLI for publication; never force-push. Do not send worker_done or invoke the orchestrated feature flow unless an Orca Dispatch explicitly requires it. Preserve unrelated existing changes and never merge a PR or create tags.",
      "permission": {
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git worktree*": "deny",
          "git push --force*": "deny"
        }
      }
    },
    "prometheus": {
      "prompt_append": "You plan either one parent feature decomposition or one Orca-dispatched GitHub sub-issue in an existing brownfield monorepo. Treat the injected Task and assigned worktree as hard scope boundaries. Produce the smallest correct plan that preserves existing architecture and behavior. Do not edit code or create worktrees, branches, commits, pushes, pull requests, GitHub mutations, or Orca Tasks. When the Task says plan-only, do not invoke /start-work; return the proposed executable leaves, dependencies, acceptance criteria, validation, overlap risks, and plan defects through worker_done so the coordinator can reconcile durable state.",
      "permission": { "github_*": "deny" }
    },
    "atlas": {
      "prompt_append": "You are the primary executor for one Orca Dispatch. Work only in the assigned worktree and branch from the injected task. You may delegate bounded implementation, exploration, research, testing, and review through OMO, but nested agents never own Git, GitHub, or Orca lifecycle state. Review all delegated output, run relevant validation, create unsigned conventional local checkpoint commits yourself, then send worker_done exactly once using the injected Orca preamble. Never push, merge, create worktrees, mutate GitHub issues, or infer completion from terminal or tmux state. The coordinator later squash-integrates checkpoint commits into the parent branch.",
      "permission": {
        "github_*": "deny",
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git worktree*": "deny",
          "git push --force*": "deny"
        }
      }
    },
    "hephaestus": {
      "prompt_append": "You are the primary autonomous executor for one explicitly deep, spike, or escalated Orca Dispatch. Stay inside the assigned worktree and branch. Do not create worktrees, push, merge, mutate GitHub, or delegate Orca lifecycle authority. For implementation outcomes, validate and create unsigned conventional local checkpoint commits yourself. Send worker_done exactly once through the injected Orca preamble; use question or escalation when the bounded goal cannot be completed safely. The coordinator later squash-integrates checkpoint commits into the parent branch.",
      "permission": {
        "github_*": "deny",
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git worktree*": "deny",
          "git push --force*": "deny"
        }
      }
    },
    "sisyphus-junior": {
      "prompt_append": "You are nested inside an Orca-owned worker. Do not run git commit, git push, git merge, git rebase, git worktree, GitHub mutation tools, or Orca lifecycle commands. Return files changed, commands run, validation evidence, and remaining risks to the primary worker.",
      "permission": {
        "github_*": "deny",
        "bash": {
          "*": "allow",
          "git commit*": "deny",
          "git push*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git worktree*": "deny",
          "orca*": "deny",
          "orca-ide*": "deny",
          "orca-dev*": "deny",
          "git push --force*": "deny"
        }
      }
    },
    "librarian": { "permission": { "edit": "deny", "bash": "ask" } },
    "explore": { "permission": { "edit": "deny", "bash": "ask" } },
    "oracle": { "permission": { "edit": "deny" } },
    "momus": { "permission": { "edit": "deny" } }
  },
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false
  }
}
