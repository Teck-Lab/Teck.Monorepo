{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "litellm/kimi-k3",
      "fallback_models": ["litellm/kimi-k2.7-code", "litellm/kimi-k2.6", "openai/gpt-5.6-terra"],
      "ultrawork": {
        "model": "openai/gpt-5.6-sol",
        "variant": "xhigh",
        "fallback_models": ["litellm/kimi-k2.7-code", "litellm/kimi-k2.6", "openai/gpt-5.6-terra"]
      },
      "prompt_append": "Delegate implementation to hephaestus and parallelize independent exploration."
    },
    "hephaestus": {
      "model": "openai/gpt-5.6-sol",
      "fallback_models": ["openai/gpt-5.6-terra"],
      "prompt_append": "You are the primary implementation agent. Own the codebase. Explore, decide, execute. Use LSP and AST-grep aggressively.",
      "permission": { "edit": "allow", "bash": { "git": "allow", "test": "allow" } }
    },
    "prometheus": {
      "model": "litellm/kimi-k3",
      "fallback_models": ["litellm/kimi-k2.7-code", "litellm/kimi-k2.6", "openai/gpt-5.6-sol"],
      "prompt_append": "Keep plans concise and name the files and decisions that matter."
    },
    "atlas": { "model": "openai/gpt-5.6-sol", "fallback_models": ["openai/gpt-5.6-terra"] },
    "oracle": { "model": "openai/gpt-5.6-sol", "fallback_models": ["openai/gpt-5.6-terra"] },
    "librarian": {
      "model": "openai/gpt-5.6-luna",
      "fallback_models": ["litellm/deepseek-v4-flash", "openai/gpt-5.6-terra"]
    },
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "fallback_models": ["litellm/deepseek-v4-flash", "openai/gpt-5.6-terra"]
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.6-sol",
      "fallback_models": ["openai/gpt-5.6-terra"]
    },
    "metis": { "model": "openai/gpt-5.6-luna", "fallback_models": ["openai/gpt-5.6-sol"] },
    "momus": {
      "model": "openai/gpt-5.6-terra",
      "fallback_models": ["openai/gpt-5.6-sol", "litellm/glm-2.2"],
      "prompt_append": "Focus on code quality, edge cases, and test coverage."
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.6-terra",
      "fallback_models": ["openai/gpt-5.6-sol"]
    }
  },
  "categories": {
    "quick": { "model": "openai/gpt-5.6-luna", "fallback_models": ["openai/gpt-5.6-sol"] },
    "unspecified-low": {
      "model": "openai/gpt-5.6-luna",
      "fallback_models": ["openai/gpt-5.6-sol"]
    },
    "unspecified-high": {
      "model": "openai/gpt-5.6-sol",
      "fallback_models": ["openai/gpt-5.6-terra"]
    },
    "visual-engineering": {
      "model": "litellm/qwen3.6-plus",
      "fallback_models": ["openai/gpt-5.6-terra"]
    },
    "deep": { "model": "openai/gpt-5.6-terra", "fallback_models": ["openai/gpt-5.6-sol"] },
    "ultrabrain": { "model": "openai/gpt-5.6-sol", "fallback_models": ["openai/gpt-5.6-terra"] }
  },
  "team_mode": {
    "enabled": true,
    "max_parallel_members": 4,
    "max_members": 8,
    "tmux_visualization": true
  },
  "background_task": {
    "defaultConcurrency": 8,
    "providerConcurrency": {
      "anthropic": 5,
      "openai": 5,
      "google": 10,
      "github-copilot": 10,
      "opencode": 15,
      "litellm": 20
    }
  },
  "hashline_edit": true,
  "experimental": {
    "aggressive_truncation": true,
    "truncate_all_tool_outputs": false,
    "task_system": true,
    "dynamic_context_pruning": {
      "enabled": true,
      "notification": "detailed",
      "turn_protection": { "enabled": true, "turns": 3 },
      "protected_tools": [
        "task",
        "todowrite",
        "todoread",
        "lsp_rename",
        "session_read",
        "session_write",
        "session_search"
      ],
      "strategies": {
        "deduplication": { "enabled": true },
        "supersede_writes": { "enabled": true, "aggressive": false },
        "purge_errors": { "enabled": true, "turns": 5 }
      }
    }
  },
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  },
  "sisyphus": {
    "tasks": {
      "storage_path": "docs/tasks",
      "claude_code_compat": false
    }
  },
  "git_master": { "commit_footer": true, "include_co_authored_by": false },
  "browser_automation_engine": { "provider": "agent-browser" }
}
