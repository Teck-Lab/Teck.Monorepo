{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": [
    {
      "plugin": "@nx/dotnet",
      "options": {
        "build": {
          "targetName": "build"
        },
        "test": {
          "targetName": "test",
          "dependsOn": ["build"]
        },
        "restore": {
          "targetName": "restore"
        },
        "publish": {
          "targetName": "publish"
        }
      }
    },
    {
      "plugin": "@nx/docker",
      "options": {
        "buildTarget": {
          "name": "docker:build",
          "args": [
            "--platform",
            "linux/amd64,linux/arm64",
            "--label",
            "org.opencontainers.image.title={projectName}",
            "--label",
            "org.opencontainers.image.revision={commitSha}",
            "--label",
            "org.opencontainers.image.version={version}",
            "--build-arg",
            "VERSION={version}",
            "--build-arg",
            "SOURCE_SHA={commitSha}",
            "--tag",
            "{imageRef}:{version}",
            "--tag",
            "{imageRef}:sha-{shortCommitSha}"
          ],
          "env": {
            "DOCKER_BUILDKIT": "1"
          }
        }
      }
    },
    {
      "plugin": "@nx/next/plugin",
      "include": ["src/apps/web"],
      "options": {
        "startTargetName": "start",
        "buildTargetName": "build",
        "devTargetName": "dev",
        "serveStaticTargetName": "serve-static",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/storybook/plugin",
      "include": ["src/apps/storybook"],
      "options": {
        "buildStorybookTargetName": "build-storybook",
        "serveStorybookTargetName": "storybook"
      }
    },
    {
      "plugin": "@nx/expo/plugin",
      "include": ["src/apps/mobile"],
      "options": {
        "startTargetName": "start",
        "serveTargetName": "serve",
        "buildTargetName": "build",
        "prebuildTargetName": "prebuild",
        "installTargetName": "install",
        "exportTargetName": "export"
      }
    }
  ],
  "targetDefaults": {
    "build": {
      "dependsOn": ["restore", "^build"],
      "cache": true,
      "inputs": [
        "default",
        "^default",
        { "env": "TECK_RELEASE_VERSION" },
        { "env": "TECK_SOURCE_REVISION" }
      ]
    },
    "restore": {
      "dependsOn": ["^restore"],
      "cache": true
    },
    "test": {
      "dependsOn": ["build"],
      "cache": true,
      "options": {
        "forwardAllArgs": false
      }
    },
    "lint": {
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "docker:build": {
      "dependsOn": ["build"],
      "cache": true,
      "inputs": [
        "default",
        "^default",
        { "env": "TECK_RELEASE_VERSION" },
        { "env": "TECK_SOURCE_REVISION" }
      ]
    }
  },
  "release": {
    "versionPlans": true,
    "version": {
      "specifierSource": "version-plans",
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "updateDependents": "always",
      "applyPreidToDependents": true
    },
    "git": {
      "commit": false,
      "tag": false,
      "stageChanges": false
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": false,
        "file": false
      },
      "automaticFromRef": true
    },
    "groups": {
      "operations": {
        "projects": ["src/services/operations/**/*"],
        "projectsRelationship": "fixed",
        "version": {
          "versionActions": ".github/scripts/nx-dotnet-version-actions.cjs"
        },
        "releaseTag": { "pattern": "operations@v{version}" }
      },
      "order": {
        "projects": ["src/services/commerce/order/**/*"],
        "projectsRelationship": "fixed",
        "version": {
          "versionActions": ".github/scripts/nx-dotnet-version-actions.cjs"
        },
        "releaseTag": { "pattern": "order@v{version}" }
      },
      "pricing": {
        "projects": ["src/services/commerce/pricing/**/*"],
        "projectsRelationship": "fixed",
        "version": {
          "versionActions": ".github/scripts/nx-dotnet-version-actions.cjs"
        },
        "releaseTag": { "pattern": "pricing@v{version}" }
      },
      "basket": {
        "projects": ["src/services/commerce/basket/**/*"],
        "projectsRelationship": "fixed",
        "version": {
          "versionActions": ".github/scripts/nx-dotnet-version-actions.cjs"
        },
        "releaseTag": { "pattern": "basket@v{version}" }
      },
      "catalog": {
        "projects": ["src/services/commerce/catalog/**/*"],
        "projectsRelationship": "fixed",
        "version": {
          "versionActions": ".github/scripts/nx-dotnet-version-actions.cjs"
        },
        "releaseTag": { "pattern": "catalog@v{version}" }
      },
      "customer": {
        "projects": ["src/services/commerce/customer/**/*"],
        "projectsRelationship": "fixed",
        "version": {
          "versionActions": ".github/scripts/nx-dotnet-version-actions.cjs"
        },
        "releaseTag": { "pattern": "customer@v{version}" }
      },
      "inventory": {
        "projects": ["src/services/commerce/inventory/**/*"],
        "projectsRelationship": "fixed",
        "version": {
          "versionActions": ".github/scripts/nx-dotnet-version-actions.cjs"
        },
        "releaseTag": { "pattern": "inventory@v{version}" }
      },
      "gateway-public": {
        "projects": ["src/services/gateway/public", "src/services/gateway/public/**/*"],
        "projectsRelationship": "fixed",
        "version": {
          "versionActions": ".github/scripts/nx-dotnet-version-actions.cjs"
        },
        "releaseTag": { "pattern": "gateway-public@v{version}" }
      },
      "web": {
        "projects": ["src/apps/*", "src/packages/*"],
        "projectsRelationship": "independent",
        "releaseTag": { "pattern": "{projectName}@v{version}" }
      }
    }
  },
  "defaultBase": "main",
  "generators": {
    "@nx/react": {
      "library": {
        "unitTestRunner": "none"
      }
    },
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "none"
      }
    }
  }
}
