<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Gateway.Public.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!--
      FastEndpoints.Messaging.Remote 8.1.0 carries MessagePack 3.1.4 as a transitive
      dependency via Gateway.Public. No patched version exists yet.
      NU1902/NU1903 suppressed so TreatWarningsAsErrors does not block the build.
    -->
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\services\gateway\public\Gateway.Public.csproj" />
  </ItemGroup>
</Project>
