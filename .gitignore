# Nx
.nx/cache
.nx/workspace-data

# Claude Code local state / nested git worktrees
# (Nx must not descend into these worktree checkouts — their stale csproj
#  references break the project-graph build.)
.claude/worktrees/
.claude/settings.local.json
.claire
# Build outputs
dist/
.next/
storybook-static/
bin/
obj/

# Dependencies
node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Direct AI provider secrets (template committed as providers.env.example)
.devcontainer/ai/providers.env

# Logs
*.log

# SDD controller scratch (ledger, briefs, review packages)
.superpowers/

# Oh My Codex runtime state is local to each disposable worktree.
.omx/

# Generated by the Orca per-workspace recipe beneath the source config so local
# Dev Container Feature paths remain valid without dirtying the checkout.
.devcontainer/.orca-runtime/
# Next.js
.next
out

# TypeScript build info
*.tsbuildinfo

# Expo
.expo/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*


# WolverineFx runtime-generated handler code. Written by `codegen write` during the container
# build (and regenerated in-memory during local dev); compiled into the published image, never committed.
**/Internal/Generated/

# Local security scan reports (tools/security-scan.sh)
.security/

# Orca local per-workspace environment (generated credentials/state)
scripts/orca-vm/.ssh/
scripts/orca-vm/local-state.json

# Orca Docker Sandbox recipe (host-local secrets/runtime state)
scripts/orca-sbx/.env

# Generated MCP backend secrets (see .devcontainer/prepare-compose.sh)
.devcontainer/mcp/mcp.env
.devcontainer/mcp/searxng/settings.yml

.devcontainer/github-app/signing-private.asc
.devcontainer/github-app/signing-public.asc
.devcontainer/github-app/proton-pass.env
