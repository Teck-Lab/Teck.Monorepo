{
  "SerilogOptions": {
    "EnableEnrichers": true,
    "EnableConsole": true,
    "EnableFile": false,
    "FilePath": "logs/gateway-web-customer-.log",
    "EnableLoki": false,
    "LokiUrl": ""
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-products-list": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/catalog/products", "Methods": ["GET"] },
        "AuthorizationPolicy": "authenticated",
        "Metadata": { "EdgeAccess": "Authenticated" }
      },
      "catalog-products-detail": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/catalog/products/{productId}", "Methods": ["GET"] },
        "AuthorizationPolicy": "authenticated",
        "Metadata": { "EdgeAccess": "Authenticated" }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "primary": { "Address": "http://catalog", "AccessTokenClientName": "catalog-api" }
        }
      }
    }
  },
  "MultiTenancy": {
    "TenantIdHeaderName": "X-TenantId",
    "OrganizationClaimName": "organization",
    "TenantIdClaimName": "tenant_id"
  },
  "Keycloak": {
    "realm": "teck",
    "auth-server-url": "http://localhost:8080",
    "resource": "web-customer-gateway",
    "credentials": { "secret": "dev-secret-change-me" }
  },
  "Services": { "CustomerApi": { "Url": "http://customer" } }
}
