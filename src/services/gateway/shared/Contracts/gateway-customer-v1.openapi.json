{
  "openapi": "3.0.0",
  "info": {
    "title": "Teck web-customer gateway API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/catalog/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Lists products.",
        "operationId": "CatalogHostEndpointsProductsListProductsEndpoint",
        "parameters": [
          {
            "name": "categoryId",
            "in": "query",
            "description": "The optional category filter.",
            "schema": {
              "type": "string",
              "format": "guid",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogApplicationProductsResponsesProductSummaryDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/FastEndpointsErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "oAuth2": []
          }
        ]
      }
    },
    "/api/v1/catalog/products/{productId}": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Fetches a product by identifier.",
        "operationId": "CatalogHostEndpointsProductsGetProductEndpoint",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "description": "The product identifier.",
            "schema": {
              "type": "string",
              "format": "guid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogApplicationProductsResponsesProductDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/FastEndpointsErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "oAuth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogApplicationProductsResponsesProductSummaryDto": {
        "type": "object",
        "description": "A lightweight product list item.",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "guid"
          },
          "name": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "categoryId": {
            "type": "string",
            "format": "guid",
            "nullable": true
          }
        }
      },
      "FastEndpointsErrorResponse": {
        "type": "object",
        "description": "the dto used to send an error response to the client",
        "additionalProperties": false,
        "properties": {
          "statusCode": {
            "type": "integer",
            "description": "the http status code sent to the client. default is 400.",
            "format": "int32",
            "default": 400
          },
          "message": {
            "type": "string",
            "description": "the message for the error response",
            "default": "One or more errors occurred!"
          },
          "errors": {
            "type": "object",
            "description": "the collection of errors for the current context",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "CatalogApplicationProductsResponsesProductDto": {
        "type": "object",
        "description": "A product with its variants.",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "guid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "categoryId": {
            "type": "string",
            "format": "guid",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogApplicationProductsResponsesVariantDto"
            }
          }
        }
      },
      "CatalogApplicationProductsResponsesVariantDto": {
        "type": "object",
        "description": "A sellable variant with its flattened sell price.",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "guid"
          },
          "sku": {
            "type": "string"
          },
          "sellPriceAmount": {
            "type": "number",
            "format": "decimal"
          },
          "sellPriceCurrency": {
            "type": "string"
          },
          "isDefault": {
            "type": "boolean"
          },
          "isActive": {
            "type": "boolean"
          },
          "attributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogApplicationProductsResponsesVariantAttributeDto"
            }
          }
        }
      },
      "CatalogApplicationProductsResponsesVariantAttributeDto": {
        "type": "object",
        "description": "A name/value variant attribute.",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "oAuth2": {
        "type": "oauth2",
        "in": "header",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://localhost:8080/realms/teck/protocol/openid-connect/auth",
            "tokenUrl": "http://localhost:8080/realms/teck/protocol/openid-connect/token",
            "refreshUrl": "http://localhost:8080/realms/teck/protocol/openid-connect/token",
            "scopes": {
              "organization": "Org"
            }
          }
        }
      }
    }
  }
}
