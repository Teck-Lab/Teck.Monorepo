{
  "TeckService": {
    "CorsPolicyName": "PricingServiceCors",
    "CorsOrigins": [],
    "HealthPath": "/health",
    "ReadyPath": "/ready"
  },
  "SerilogOptions": {
    "EnableEnrichers": true,
    "EnableConsole": true,
