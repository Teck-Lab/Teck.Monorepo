{
  "TeckService": {
    "CorsPolicyName": "BillingServiceCors",
    "CorsOrigins": [],
    "HealthPath": "/health",
    "ReadyPath": "/ready"
  },
  "SerilogOptions": {
    "EnableEnrichers": true,
    "EnableConsole": true,
    "EnableFile": false,
    "FilePath": "logs/billing-.log",
    "EnableLoki": false,
    "LokiUrl": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PaymentProvider": {
    "SimulateSuccess": true,
    "ProviderName": "stub",
    "DefaultCurrency": "USD",
    "MaxTransientRetries": 2,
    "StubOutcome": "succeeded",
    "StubDeclineCode": "generic_decline",
    "DeclineMappings": {
      "temporary_unavailable": "transient",
      "authentication_required": "authentication-required",
      "payment_method_required": "payment-method-required",
      "issuer_contact": "issuer-contact-required"
    }
  },
  "TenantPurchase": {
    "PlanVersion": "2026-10",
    "AllowedDatabaseProviders": [ "postgres" ],
    "ReadReplicaMonthlyRate": 15.00
  },
  "SubscriptionExpiry": {
    "PollInterval": "01:00:00"
  },
  "CustomerReservations": {
    "TokenEndpoint": "http://keycloak:8080/realms/teck/protocol/openid-connect/token",
    "ClientId": "billing-api",
    "ClientSecret": "",
    "Scope": "tenant-purchase customer-api-audience",
    "CustomerBaseUrl": "http://customer:5000/"
  },
  "AllowedHosts": "*"
}
