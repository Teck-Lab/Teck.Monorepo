{
  "TeckService": {
    "CorsPolicyName": "BillingServiceCors",
    "CorsOrigins": [],
    "HealthPath": "/health",
    "ReadyPath": "/ready"
  },
  "SerilogOptions": {
    "EnableEnrichers": true,
    "EnableConsole": true,
    "EnableFile": false,
    "FilePath": "logs/billing-.log",
    "EnableLoki": false,
    "LokiUrl": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PaymentProvider": {
    "SimulateSuccess": true,
    "ProviderName": "stub",
    "DefaultCurrency": "USD",
    "MaxTransientRetries": 2,
    "StubOutcome": "succeeded",
    "StubDeclineCode": "generic_decline",
    "DeclineMappings": {
      "temporary_unavailable": "transient",
      "authentication_required": "authentication-required",
      "payment_method_required": "payment-method-required",
      "issuer_contact": "issuer-contact-required"
    }
  },
  "AllowedHosts": "*"
}
