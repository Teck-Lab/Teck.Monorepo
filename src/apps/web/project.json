{
  "name": "web",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "src/apps/web",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project web --web",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "biome check src/apps/web"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "src/apps/web",
        "command": "tsc --noEmit"
      }
    }
  }
}
