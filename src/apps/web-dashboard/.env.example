# Keycloak OIDC client (confidential client configured with catalog-api audience).
KEYCLOAK_ISSUER=http://localhost:8080/realms/teck
KEYCLOAK_CLIENT_ID=teck-dashboard
KEYCLOAK_CLIENT_SECRET=
# Set to a unique, cryptographically random value for each environment.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Canonical public origin used to reject cross-origin cookie-authenticated POSTs (set exactly to NEXTAUTH_URL at deployment).
DASHBOARD_ORIGIN=http://localhost:3000
# Public YARP base URL; it routes /products and /products/{productId}.
CATALOG_API_BASE_URL=http://localhost:8080
