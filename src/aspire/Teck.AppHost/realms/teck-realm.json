{
  "realm": "teck",
  "enabled": true,
  "sslRequired": "external",
  "organizationsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "platform-reader"
      },
      {
        "name": "platform-manager"
      }
    ]
  },
  "clients": [
    {
      "clientId": "order-api",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "REPLACE_WITH_ENVIRONMENT_SECRET_ORDER_API",
      "authorizationServicesEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "organization-membership",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-organization-membership-mapper",
          "config": {
            "claim.name": "organization",
            "jsonType.label": "JSON",
            "multivalued": "true",
            "addOrganizationId": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "order-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "order-api",
            "access.token.claim": "true"
          }
        }
      ],
      "authorizationSettings": {
        "policyEnforcementMode": "ENFORCING",
        "resources": [
          {
            "name": "order",
            "scopes": [
              {
                "name": "read"
              },
              {
                "name": "retry-payment"
              }
            ]
          }
        ],
        "policies": [
          {
            "name": "order-read-roles",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"platform-reader\",\"required\":false},{\"id\":\"platform-manager\",\"required\":false}]",
              "fetchRoles": "true"
            }
          },
          {
            "name": "order-read",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "scopes": "[\"read\"]",
              "applyPolicies": "[\"order-read-roles\"]"
            }
          },
          {
            "name": "order-retry-payment-manager",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"platform-manager\",\"required\":false}]",
              "fetchRoles": "true"
            }
          },
          {
            "name": "order-retry-payment",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "scopes": "[\"retry-payment\"]",
              "applyPolicies": "[\"order-retry-payment-manager\"]"
            }
          }
        ]
      },
      "directAccessGrantsEnabled": false
