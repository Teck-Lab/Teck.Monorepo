#!/usr/bin/env bun

import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
import { dirname, isAbsolute, join, resolve } from "node:path";

type Kind = "feature" | "plan-defect" | "validation";
type WorkStatus = "ready" | "dispatched" | "completed" | "blocked" | "integrated" | "removed";
type ExecutionMode = "planned" | "autonomous" | "quick" | "spike";

interface WorktreeEntry {
  issue: number;
  title: string;
  slug: string;
  kind: Kind;
  branch: string;
  path: string;
  orcaWorktreeId?: string;
  dependsOn: number[];
  executionMode: ExecutionMode;
  status: WorkStatus;
  integratedCommit?: string;
}

interface FeatureState {
  schemaVersion: 1;
  parentIssue: number;
  parentSlug: string;
  parentTitle: string;
  parentBranch: string;
  baseBranch: string;
  parentRoot: string;
  worktreeRoot: string;
  worktrees: WorktreeEntry[];
}

interface CommandResult {
  exitCode: number;
  stdout: string;
  stderr: string;
}

class FlowError extends Error {}

function run(args: string[], cwd?: string, check = true): CommandResult {
  const result = Bun.spawnSync(args, {
    cwd,
    stdout: "pipe",
    stderr: "pipe",
  });
  const output = {
    exitCode: result.exitCode,
    stdout: result.stdout.toString(),
    stderr: result.stderr.toString(),
  };
  if (check && output.exitCode !== 0) {
    const detail = output.stderr.trim() || output.stdout.trim();
    throw new FlowError(`${args.join(" ")} failed: ${detail}`);
  }
  return output;
}

function git(args: string[], cwd?: string, check = true): CommandResult {
  return run(["git", ...args], cwd, check);
}

function repositoryRoot(): string {
  return resolve(git(["rev-parse", "--show-toplevel"]).stdout.trim());
}

function repositoryRootAt(path: string): string {
  return resolve(git(["rev-parse", "--show-toplevel"], path).stdout.trim());
}

function commonGitDirectory(root: string): string {
  const value = git(["rev-parse", "--git-common-dir"], root).stdout.trim();
  return resolve(isAbsolute(value) ? value : join(root, value));
}

function statePath(root: string): string {
  return join(commonGitDirectory(root), "orca-feature", "state.json");
}

function loadState(root: string): FeatureState {
  const path = statePath(root);
  if (!existsSync(path)) {
    throw new FlowError("feature flow is not initialized; run 'tools/orca-feature init' first");
  }
  return JSON.parse(readFileSync(path, "utf8")) as FeatureState;
}

function saveState(root: string, state: FeatureState): void {
  const path = statePath(root);
  mkdirSync(dirname(path), { recursive: true });
  const temporary = `${path}.tmp`;
  writeFileSync(temporary, `${JSON.stringify(state, null, 2)}\n`, { mode: 0o600 });
  renameSync(temporary, path);
}

function slugify(value: string): string {
  const slug = value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
  if (!slug) throw new FlowError("slug must contain a letter or number");
  return slug;
}

function shellQuote(value: string): string {
  return `'${value.replaceAll("'", `'\\''`)}'`;
}

function executionMode(raw: string | undefined, fallback: ExecutionMode = "planned"): ExecutionMode {
  const value = raw ?? fallback;
  if (!(["planned", "autonomous", "quick", "spike"] as string[]).includes(value)) {
    throw new FlowError(`unsupported --mode: ${value}`);
  }
  return value as ExecutionMode;
}

function primaryAgent(mode: ExecutionMode): string {
  return ["autonomous", "spike"].includes(mode)
    ? "Hephaestus - Deep Agent"
    : "Prometheus - Plan Builder";
}

function branchExists(root: string, branch: string): boolean {
  return git(["show-ref", "--verify", "--quiet", `refs/heads/${branch}`], root, false).exitCode === 0;
}

function currentBranch(root: string): string {
  const branch = git(["branch", "--show-current"], root).stdout.trim();
  if (!branch) throw new FlowError("detached HEAD is not supported");
  return branch;
}

function isClean(path: string): boolean {
  return git(["status", "--porcelain"], path).stdout.trim() === "";
}

function requireClean(path: string, label: string): void {
  if (!isClean(path)) throw new FlowError(`${label} has uncommitted changes: ${path}`);
}

function requireWorkerCommits(root: string, parentBranch: string, workerBranch: string): void {
  const commits = git(["rev-list", `${parentBranch}..${workerBranch}`], root).stdout
    .split("\n")
    .filter(Boolean);
  if (commits.length === 0) throw new FlowError(`branch ${workerBranch} has no commits beyond ${parentBranch}`);
}

function githubRepository(root: string): string {
  const url = git(["remote", "get-url", "origin"], root).stdout.trim();
  const match = /(?:github\.com[/:])([^/]+\/[^/]+?)(?:\.git)?$/.exec(url);
  if (!match) throw new FlowError(`origin is not a GitHub repository: ${url}`);
  return match[1];
}

function entryFor(state: FeatureState, issue: number): WorktreeEntry {
  const entry = state.worktrees.find((item) => item.issue === issue);
  if (!entry) throw new FlowError(`sub-issue #${issue} is not registered`);
  return entry;
}

function defaultBase(root: string): string {
  const remote = git(["symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD"], root, false);
  return remote.exitCode === 0 && remote.stdout.trim() ? remote.stdout.trim() : "origin/main";
}

interface ParsedOptions {
  values: Map<string, string[]>;
  flags: Set<string>;
}

function parseOptions(args: string[]): ParsedOptions {
  const values = new Map<string, string[]>();
  const flags = new Set<string>();
  for (let index = 0; index < args.length; index += 1) {
    const key = args[index];
    if (!key.startsWith("--")) throw new FlowError(`unexpected argument: ${key}`);
    const next = args[index + 1];
    if (next === undefined || next.startsWith("--")) {
      flags.add(key);
      continue;
    }
    values.set(key, [...(values.get(key) ?? []), next]);
    index += 1;
  }
  return { values, flags };
}

function option(options: ParsedOptions, name: string): string | undefined {
  return options.values.get(name)?.at(-1);
}

function requiredOption(options: ParsedOptions, name: string): string {
  const value = option(options, name);
  if (!value) throw new FlowError(`${name} is required`);
  return value;
}

function integerOption(options: ParsedOptions, name: string): number {
  const raw = requiredOption(options, name);
  const value = Number(raw);
  if (!Number.isInteger(value) || value <= 0) throw new FlowError(`${name} must be a positive integer`);
  return value;
}

function repeatedIntegers(options: ParsedOptions, name: string): number[] {
  return (options.values.get(name) ?? []).map((raw) => {
    const value = Number(raw);
    if (!Number.isInteger(value) || value <= 0) throw new FlowError(`${name} must contain positive integers`);
    return value;
  });
}

function worktreeStatus(root: string, state: FeatureState, entry: WorktreeEntry) {
  const exists = existsSync(entry.path);
  const clean = exists && isClean(entry.path);
  const head = exists ? git(["rev-parse", "HEAD"], entry.path).stdout.trim() : null;
  const counts = git(["rev-list", "--left-right", "--count", `${state.parentBranch}...${entry.branch}`], root)
    .stdout.trim().split(/\s+/).map(Number);
  const merged = entry.integratedCommit
    ? git(["merge-base", "--is-ancestor", entry.integratedCommit, state.parentBranch], root, false).exitCode === 0
    : false;
  return { ...entry, exists, clean, head, behind: counts[0], ahead: counts[1], merged };
}

function initialize(options: ParsedOptions): void {
  const root = repositoryRoot();
  const path = statePath(root);
  if (existsSync(path)) {
    const state = loadState(root);
    throw new FlowError(`already initialized for parent issue #${state.parentIssue} on ${state.parentBranch}`);
  }

  requireClean(root, "parent checkout");
  const issue = integerOption(options, "--issue");
  const slug = slugify(requiredOption(options, "--slug"));
  const previous = currentBranch(root);
  const featureBranch = option(options, "--branch") ?? `feature/${issue}-${slug}`;
  const baseBranch = option(options, "--base") ?? defaultBase(root);

  if (options.flags.has("--create-branch")) {
    if (branchExists(root, featureBranch)) throw new FlowError(`branch already exists: ${featureBranch}`);
    git(["switch", "-c", featureBranch], root);
  } else if (previous !== featureBranch) {
    throw new FlowError(
      `current branch is ${previous}; pass --branch ${JSON.stringify(previous)} to adopt it or --create-branch to create ${featureBranch}`,
    );
  }

  const state: FeatureState = {
    schemaVersion: 1,
    parentIssue: issue,
    parentSlug: slug,
    parentTitle: option(options, "--title") ?? "",
    parentBranch: featureBranch,
    baseBranch,
    parentRoot: root,
    worktreeRoot: join(dirname(root), ".orca-worktrees", String(issue)),
    worktrees: [],
  };
  saveState(root, state);
  console.log(options.flags.has("--json") ? JSON.stringify(state, null, 2) : `Initialized #${issue} on ${featureBranch}`);
}

function registerWorktree(options: ParsedOptions): void {
  const root = repositoryRoot();
  const state = loadState(root);
  const issue = integerOption(options, "--issue");
  if (issue === state.parentIssue) throw new FlowError("a parent issue cannot be its own sub-issue");
  if (state.worktrees.some((item) => item.issue === issue)) throw new FlowError(`sub-issue #${issue} is already registered`);

  const title = option(options, "--title") ?? "";
  const slug = slugify(option(options, "--slug") ?? (title || String(issue)));
  const path = resolve(requiredOption(options, "--path"));
  const branch = requiredOption(options, "--branch");
  const orcaWorktreeId = requiredOption(options, "--worktree-id");
  if (!existsSync(path)) throw new FlowError(`Orca worktree path does not exist: ${path}`);
  const registeredRoot = repositoryRootAt(path);
  if (registeredRoot !== path) throw new FlowError(`registered path is not a Git worktree root: ${path}`);
  if (currentBranch(path) !== branch) throw new FlowError(`registered path is not on branch ${branch}: ${path}`);
  if (branch === state.parentBranch) throw new FlowError("child worktree must not use the parent feature branch");

  const dependencies = [...new Set(repeatedIntegers(options, "--depends-on"))].sort((a, b) => a - b);
  const known = new Set(state.worktrees.map((item) => item.issue));
  const unknown = dependencies.filter((dependency) => !known.has(dependency));
  if (unknown.length) throw new FlowError(`dependencies must be registered first: ${unknown.map((item) => `#${item}`).join(", ")}`);

  const rawKind = option(options, "--kind") ?? "feature";
  if (!["feature", "plan-defect", "validation"].includes(rawKind)) throw new FlowError(`unsupported --kind: ${rawKind}`);
  const kind = rawKind as Kind;
  const mode = executionMode(option(options, "--mode"), kind === "validation" ? "quick" : "planned");
  const entry: WorktreeEntry = {
    issue,
    title,
    slug,
    kind,
    branch,
    path,
    orcaWorktreeId,
    dependsOn: dependencies,
    executionMode: mode,
    status: "ready",
  };
  state.worktrees.push(entry);
  state.worktrees.sort((a, b) => a.issue - b.issue);
  saveState(root, state);
  console.log(options.flags.has("--json") ? JSON.stringify(entry, null, 2) : `Registered #${issue}: ${path} (${branch})`);
}

function showStatus(options: ParsedOptions): void {
  const root = repositoryRoot();
  const state = loadState(root);
  const result = {
    parentIssue: state.parentIssue,
    parentBranch: state.parentBranch,
    baseBranch: state.baseBranch,
    parentRoot: state.parentRoot,
    parentClean: isClean(state.parentRoot),
    worktrees: state.worktrees.map((entry) => worktreeStatus(root, state, entry)),
  };
  if (options.flags.has("--json")) {
    console.log(JSON.stringify(result, null, 2));
    return;
  }
  console.log(`Parent #${result.parentIssue}: ${result.parentBranch} (${result.parentClean ? "clean" : "dirty"})`);
  for (const item of result.worktrees) {
    const flags = [item.status, item.clean ? "clean" : "dirty", `ahead ${item.ahead}`];
    if (item.merged) flags.push("merged");
    console.log(`  #${item.issue} ${item.kind}: ${item.branch} [${flags.join(", ")}]`);
  }
}

function dispatchInfo(options: ParsedOptions): void {
  if (option(options, "--harness") !== undefined || options.flags.has("--harness")) {
    throw new FlowError("--harness was removed; full OMO is the only worker runtime");
  }
  const root = repositoryRoot();
  const state = loadState(root);
  const entry = entryFor(state, integerOption(options, "--issue"));
  const pending = entry.dependsOn.filter((issue) => entryFor(state, issue).status !== "integrated");
  const status = worktreeStatus(root, state, entry);
  const mode = executionMode(option(options, "--mode"), entry.executionMode ?? "planned");
  const agent = primaryAgent(mode);
  const launcherArgs = [
    "teck-omo-worker",
    "--worktree", entry.path,
    "--parent-issue", String(state.parentIssue),
    "--issue", String(entry.issue),
    "--slug", entry.slug,
    "--mode", mode,
  ];
  const modeInstruction = mode === "planned"
    ? "Use Prometheus to create and review a constrained plan, then /start-work so Atlas executes it."
    : mode === "quick"
      ? "Use Prometheus to create a compact bounded plan, then /start-work so Atlas delegates inexpensive quick tasks."
      : mode === "spike"
        ? "Use Hephaestus for a bounded investigation; do not create production commits unless the task explicitly requires them."
        : "Use Hephaestus as the autonomous GPT-native primary executor for this deep task.";
  console.log(JSON.stringify({
    ...entry,
    executionMode: mode,
    primaryAgent: agent,
    launcherArgs,
    terminalCommand: launcherArgs.map(shellQuote).join(" "),
    parentIssue: state.parentIssue,
    parentBranch: state.parentBranch,
    blockedBy: pending,
    needsSync: status.behind > 0,
    ready: pending.length === 0 && status.behind === 0 && entry.status === "ready",
    taskSpec: `Implement GitHub sub-issue #${entry.issue} (${entry.kind}, ${mode}): ${entry.title || entry.slug}. ${modeInstruction} Work only in ${entry.path} on branch ${entry.branch}. Nested agents may not commit, push, merge, create worktrees, mutate GitHub, or send Orca lifecycle messages. The primary worker must review delegated output, run relevant checks, create conventional local checkpoint commits without pushing them, and send worker_done exactly once.`,
  }, null, 2));
}

function syncWorktree(options: ParsedOptions): void {
  const root = repositoryRoot();
  const state = loadState(root);
  const issue = integerOption(options, "--issue");
  const entry = entryFor(state, issue);
  if (!["ready", "blocked"].includes(entry.status)) throw new FlowError(`refusing to sync #${issue} while status is ${entry.status}`);
  const pending = entry.dependsOn.filter((dependency) => entryFor(state, dependency).status !== "integrated");
  if (pending.length) throw new FlowError(`sub-issue #${issue} is blocked by ${pending.map((item) => `#${item}`).join(", ")}`);
  requireClean(entry.path, `sub-issue #${issue} worktree`);
  const result = git(["merge", "--ff-only", state.parentBranch], entry.path, false);
  if (result.exitCode !== 0) {
    throw new FlowError(`cannot fast-forward #${issue} to ${state.parentBranch}; the branch has diverged or has active work: ${result.stderr.trim() || result.stdout.trim()}`);
  }
  entry.status = "ready";
  saveState(root, state);
  console.log(`Synchronized #${issue} with ${state.parentBranch}`);
}

function setWorkStatus(options: ParsedOptions): void {
  const root = repositoryRoot();
  const state = loadState(root);
  const issue = integerOption(options, "--issue");
  const value = requiredOption(options, "--status");
  if (!["ready", "dispatched", "completed", "blocked"].includes(value)) throw new FlowError(`unsupported --status: ${value}`);
  entryFor(state, issue).status = value as WorkStatus;
  saveState(root, state);
  console.log(`#${issue} status: ${value}`);
}

function integrate(options: ParsedOptions): void {
  const root = repositoryRoot();
  const state = loadState(root);
  const issue = integerOption(options, "--issue");
  const entry = entryFor(state, issue);
  if (currentBranch(state.parentRoot) !== state.parentBranch) throw new FlowError(`integration must run with ${state.parentBranch} checked out at ${state.parentRoot}`);
  requireClean(state.parentRoot, "parent checkout");
  requireClean(entry.path, `sub-issue #${issue} worktree`);

  const pending = entry.dependsOn.filter((dependency) => entryFor(state, dependency).status !== "integrated");
  if (pending.length) throw new FlowError(`sub-issue #${issue} is blocked by ${pending.map((item) => `#${item}`).join(", ")}`);
  const status = worktreeStatus(root, state, entry);
  if (status.ahead === 0 && !status.merged) throw new FlowError(`sub-issue #${issue} has no commits to integrate`);
  if (status.merged) {
    entry.status = "integrated";
    saveState(root, state);
    console.log(`#${issue} was already merged; marked integrated`);
    return;
  }

  requireWorkerCommits(root, state.parentBranch, entry.branch);
  const message = option(options, "--message") ?? `feat(${state.parentSlug}): integrate #${issue} ${entry.slug}`;
  const merge = git(["merge", "--squash", entry.branch], state.parentRoot, false);
  if (merge.exitCode !== 0) {
    throw new FlowError(`merge stopped before integration completed; resolve or abort it in the parent checkout:\n${merge.stderr.trim() || merge.stdout.trim()}`);
  }
  git(["commit", "-m", message], state.parentRoot);
  entry.status = "integrated";
  entry.integratedCommit = git(["rev-parse", "HEAD"], state.parentRoot).stdout.trim();
  saveState(root, state);
  console.log(`Integrated #${issue} as ${entry.integratedCommit}`);
}

function removeWorktree(options: ParsedOptions): void {
  const root = repositoryRoot();
  const state = loadState(root);
  const issue = integerOption(options, "--issue");
  const entry = entryFor(state, issue);
  if (entry.status !== "integrated") throw new FlowError(`refusing to remove #${issue}: status is ${entry.status}, not integrated`);
  if (existsSync(entry.path)) {
    throw new FlowError(`Orca still owns the child checkout: ${entry.path}; release its Dispatch and remove it with 'orca worktree rm' first`);
  }
  if (!entry.integratedCommit || git(["merge-base", "--is-ancestor", entry.integratedCommit, state.parentBranch], root, false).exitCode !== 0) {
    throw new FlowError(`refusing to remove #${issue}: integrated commit is not contained in ${state.parentBranch}`);
  }
  entry.status = "removed";
  saveState(root, state);
  console.log(`Removed worktree for #${issue}; branch retained: ${entry.branch}`);
}

function prInfo(): void {
  const root = repositoryRoot();
  const state = loadState(root);
  const integrated = state.worktrees.filter((entry) => ["integrated", "removed"].includes(entry.status)).map((entry) => entry.issue);
  const incomplete = state.worktrees.filter((entry) => !["integrated", "removed"].includes(entry.status)).map((entry) => entry.issue);
  console.log(JSON.stringify({
    parentIssue: state.parentIssue,
    head: state.parentBranch,
    base: state.baseBranch.replace(/^origin\//, ""),
    integratedSubIssues: integrated,
    incompleteSubIssues: incomplete,
    ready: incomplete.length === 0 && isClean(state.parentRoot),
  }, null, 2));
}

const help = `usage: tools/orca-feature <command> [options]

commands:
  init           adopt or create the parent feature branch
  register       register an existing native Orca child worktree
  status         show parent and worktree integration state
  dispatch-info  emit an Orca task/terminal payload
  sync           fast-forward an undispatched child to the parent
  set-status     record worker lifecycle state
  integrate      merge a completed sub-feature into the parent
  remove         record a native child already removed through Orca
  pr-info        emit final PR readiness and branch information`;

function main(): void {
  const [command, ...rawOptions] = process.argv.slice(2);
  if (!command || command === "--help" || command === "-h") {
    console.log(help);
    return;
  }
  const options = parseOptions(rawOptions);
  switch (command) {
    case "init": initialize(options); break;
    case "register": registerWorktree(options); break;
    case "status": showStatus(options); break;
    case "dispatch-info": dispatchInfo(options); break;
    case "sync": syncWorktree(options); break;
    case "set-status": setWorkStatus(options); break;
    case "integrate": integrate(options); break;
    case "remove": removeWorktree(options); break;
    case "pr-info": prInfo(); break;
    default: throw new FlowError(`unknown command: ${command}\n${help}`);
  }
}

try {
  main();
} catch (error) {
  console.error(`error: ${error instanceof Error ? error.message : String(error)}`);
  process.exit(1);
}
