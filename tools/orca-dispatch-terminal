#!/usr/bin/env bash
set -euo pipefail

task_id=""
terminal_handle=""
while (($#)); do
  case "$1" in
    --task) task_id="${2:-}"; shift 2 ;;
    --terminal) terminal_handle="${2:-}"; shift 2 ;;
    *) echo "usage: tools/orca-dispatch-terminal --task TASK --terminal HANDLE" >&2; exit 2 ;;
  esac
done
test -n "$task_id" || { echo "--task is required" >&2; exit 2; }
test -n "$terminal_handle" || { echo "--terminal is required" >&2; exit 2; }

dispatch_response="$(orca orchestration dispatch --task "$task_id" --to "$terminal_handle" --return-preamble --json)"
preamble="$(jq -er 'select(.ok == true) | .result.preamble | select(type == "string" and length > 0)' <<<"$dispatch_response")" || {
  echo "$dispatch_response" >&2
  echo "Orca did not return the authoritative lifecycle preamble" >&2
  exit 1
}

delivery_response="$(orca terminal send --terminal "$terminal_handle" --text "$preamble" --enter --json)"
jq -e 'select(.ok == true)' >/dev/null <<<"$delivery_response" || {
  echo "$delivery_response" >&2
  echo "Dispatch exists but its preamble was not delivered; inspect dispatch-show" >&2
  exit 1
}

jq -n --argjson dispatch "$dispatch_response" --argjson delivery "$delivery_response" \
  '{ok:true, dispatch:$dispatch.result.dispatch, delivered:true, delivery:$delivery.result}'
