#!/usr/bin/env bun

import { readFileSync } from "node:fs";

const path = process.argv[2];
if (!path) {
  console.error("usage: tools/teck-agent-contract <artifact.xml>");
  process.exit(2);
}

const xml = readFileSync(path, "utf8");
const errors: string[] = [];

function hasTag(name: string, source = xml): boolean {
  return new RegExp(`<${name}(?:\\s[^>]*)?>[\\s\\S]*?</${name}>`, "i").test(source);
}

function value(name: string, source = xml): string {
  return source.match(new RegExp(`<${name}(?:\\s[^>]*)?>([\\s\\S]*?)</${name}>`, "i"))?.[1].trim() ?? "";
}

function requireTags(names: string[], source = xml): void {
  for (const name of names) if (!hasTag(name, source)) errors.push(`missing <${name}>`);
}

function validateRouting(source = xml): void {
  requireTags(["routing", "work-kind", "workflow-stage", "route"], source);
  const workKind = value("work-kind", source);
  const stage = value("workflow-stage", source);
  const route = value("route", source);
  if (!/^(bug-fix|feature|security-fix|maintenance|build-config|agent-workflow|docs|research)$/.test(workKind)) errors.push(`invalid work-kind: ${workKind}`);
  if (!/^(intake|discovery|planning|plan-review|execution|code-review|integration|qa|coordination)$/.test(stage)) errors.push(`invalid workflow-stage: ${stage}`);
  if (route !== `${workKind}:${stage}`) errors.push(`route mismatch: expected ${workKind}:${stage}`);
}

const root = xml.match(/^\s*<([a-z-]+)\s+version="1">/i)?.[1];
if (!root) errors.push("missing supported version=\"1\" root envelope");

if (root === "task-contract") {
  validateRouting();
  requireTags(["role", "objective", "sources", "scope", "acceptance", "validation", "constraints", "execution-mode", "model-route", "permissions", "result-contract"]);
  if (!/^(ephemeral-helper|shared-durable|parallel-child|consolidation)$/.test(value("execution-mode"))) errors.push("invalid execution-mode");
  if (value("workflow-stage") === "discovery") {
    if (!hasTag("discovery-anchor")) errors.push("discovery task lacks discovery-anchor");
    if (!/^(discovery-researcher|discovery-prototyper)$/.test(value("role"))) errors.push("invalid discovery role");
    if (value("result-contract") !== "discovery-result-v1") errors.push("discovery task requires discovery-result-v1");
  } else if (!/<parent-issue\s+href="https:\/\/github\.com\/[^/]+\/[^/]+\/issues\/\d+"\s*\/>/i.test(xml)) errors.push("missing canonical GitHub parent-issue href");
  if (/<(?:task-id|dispatch-id)>/i.test(xml)) errors.push("task contract duplicates Orca lifecycle identity");
} else if (root === "discovery-result") {
  validateRouting();
  requireTags(["outcome", "question", "method", "findings", "evidence", "artifacts", "product-implications", "unresolved-decisions"]);
  if (!/^(succeeded|failed)$/.test(value("outcome"))) errors.push("invalid discovery outcome");
  if (value("workflow-stage") !== "discovery") errors.push("discovery-result workflow-stage must be discovery");
} else if (root === "plan-result") {
  validateRouting();
  requireTags(["validation-profile", "plan-digest", "review-units", "dependency-waves", "validation-strategy", "decisions"]);
  if (!/^(product-code|build-config|agent-workflow|docs-research)$/.test(value("validation-profile"))) errors.push("invalid validation-profile");
  if (value("workflow-stage") !== "planning") errors.push("plan-result workflow-stage must be planning");
} else if (root === "implementation-result") {
  validateRouting();
  requireTags(["outcome", "base-sha", "tip-sha", "files-modified", "validation-evidence", "remaining-risks"]);
  if (!/^(succeeded|failed)$/.test(value("outcome"))) errors.push("invalid implementation outcome");
  if (value("workflow-stage") !== "execution") errors.push("implementation-result workflow-stage must be execution");
} else if (root === "review-result" || root === "qa-result") {
  validateRouting();
  requireTags(root === "review-result"
    ? ["verdict", "reviewed-sha", "plan-digest", "findings", "follow-ups"]
    : ["verdict", "integrated-sha", "plan-digest", "acceptance-evidence", "findings", "follow-ups"]);

  const verdict = value("verdict");
  if (!/^(CLEAN|FINDINGS_PRESENT)$/.test(verdict)) errors.push("invalid verdict");
  const findingBodies = [...xml.matchAll(/<finding>([\s\S]*?)<\/finding>/gi)].map((match) => match[1]);
  const keys = new Set<string>();
  let actionable = 0;
  for (const finding of findingBodies) {
    requireTags(["finding-key", "classification", "severity", "violated-contract", "evidence", "minimal-repair", "scope-effect"], finding);
    const key = value("finding-key", finding);
    if (keys.has(key)) errors.push(`duplicate finding-key: ${key}`);
    keys.add(key);
    const classification = value("classification", finding);
    if (!/^(blocking-defect|bounded-omission|scope-expansion|observation)$/.test(classification)) errors.push(`invalid classification: ${classification}`);
    if (/^(blocking-defect|bounded-omission)$/.test(classification)) {
      actionable++;
      if (!value("violated-contract", finding) || value("violated-contract", finding) === "none") errors.push(`actionable finding ${key} lacks violated contract`);
      if (!value("evidence", finding)) errors.push(`actionable finding ${key} lacks evidence`);
      if (!value("minimal-repair", finding)) errors.push(`actionable finding ${key} lacks minimal repair`);
      if (value("scope-effect", finding) !== "within-scope") errors.push(`actionable finding ${key} expands scope`);
    }
  }
  if (verdict === "CLEAN" && actionable > 0) errors.push("CLEAN contradicts actionable findings");
  if (verdict === "FINDINGS_PRESENT" && actionable === 0) errors.push("FINDINGS_PRESENT requires an actionable finding");
  if (root === "review-result" && !/^(plan-review|code-review)$/.test(value("workflow-stage"))) errors.push("review-result workflow-stage must be plan-review or code-review");
  if (root === "qa-result" && value("workflow-stage") !== "qa") errors.push("qa-result workflow-stage must be qa");
} else if (root === "handoff") {
  validateRouting();
  requireTags(["purpose", "anchor", "verified-facts", "unverified-assumptions", "active-orca-state", "durable-references", "next-action", "suggested-skills"]);
} else if (root) {
  errors.push(`unsupported contract root: ${root}`);
}

if (errors.length) {
  console.error(JSON.stringify({ valid: false, errors }, null, 2));
  process.exit(1);
}

console.log(JSON.stringify({ valid: true, type: root, path }));
