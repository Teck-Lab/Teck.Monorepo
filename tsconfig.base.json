{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "strict": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@teck/tailwind-config/*": ["src/packages/tailwind-config/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
